@echo off
REM Copy this file to env.bat in the same folder as build_falcon_m28.bat
REM and edit the three paths. env.bat is personal — do not commit it.
REM
REM You need (unpacked folders only — do NOT install AndeSight or Gowin RDS):
REM   1. Andes nds32le-elf-newlib-v5 toolchain (riscv32-elf-gcc.exe)
REM   2. Cygwin DLLs next to that toolchain (cygwin1.dll)
REM   3. Gowin RiscV_AE350_SOC_V1.3 SDK zip (headers, BSP, ae350-ddr.ld)
REM See FIRST_TIME.md.

set FALCON_TC=C:\Dev\AndeSight_RDS_v511\toolchains\nds32le-elf-newlib-v5\bin
set FALCON_CYGBIN=C:\Dev\AndeSight_RDS_v511\cygwin\bin
set FALCON_SDK=C:\Dev\RiscV_AE350_SOC_V1.3

REM Optional. Default is the folder that contains build_falcon_m28.bat.
REM set FALCON_MUSASHI=C:\Dev\build\musashi
