diff --git a/Atarist_030_wip/helper_fw/ready/build_ready.bat b/Atarist_030_wip/helper_fw/ready/build_ready.bat
index d45d450..e904eaf 100644
--- a/Atarist_030_wip/helper_fw/ready/build_ready.bat
+++ b/Atarist_030_wip/helper_fw/ready/build_ready.bat
@@ -1,6 +1,9 @@
 @echo off
 REM Builds the AE350 ready stub. Flash the bin at 0x0600000, C Bin,
 REM Program Without Erasure. Do not erase the bitstream or the TOS slot.
+REM Source set matches Hybrid030 build_falcon_m28.bat (the image that boots):
+REM loader.c holds the BUILD_BURN boot_loader (.bootloader at 0x80000000) that
+REM copies the DDR-linked image out of flash. Without it nothing reaches main.
 setlocal
 set "HERE=%~dp0"
 if exist "%HERE%env.bat" call "%HERE%env.bat"
@@ -10,14 +13,18 @@ if not defined FALCON_CYGBIN set "FALCON_CYGBIN=C:\Dev\AndeSight_RDS_v511\cygwin
 set "PATH=%FALCON_TC%;%FALCON_CYGBIN%;%PATH%"
 set "GCC=%FALCON_TC%\riscv32-elf-gcc.exe"
 set "OBJCOPY=%FALCON_TC%\riscv32-elf-objcopy.exe"
+set "OBJDUMP=%FALCON_TC%\riscv32-elf-objdump.exe"
 set "BSP=%FALCON_SDK%\library\bsp"
 set "OUT=%HERE%output"
 if not exist "%OUT%" mkdir "%OUT%"
 set INC=-I"%BSP%\ae350" -I"%BSP%\config" -I"%BSP%\driver\ae350" -I"%BSP%\driver\include" -I"%BSP%\lib"
-set CFLAGS=%INC% -O2 -mcmodel=medium -g3 -Wall -mcpu=a25 -ffunction-sections -fdata-sections -fno-builtin -fomit-frame-pointer
+set CFLAGS=-DREF_TEST_CLK %INC% -O2 -mcmodel=medium -g3 -Wall -mcpu=a25 -ffunction-sections -fdata-sections -fno-builtin -fomit-frame-pointer
 set LDFLAGS=-mcpu=a25 -O2 -nostartfiles -static -T"%BSP%\sag\ae350-ddr.ld" -Wl,--gc-sections
-"%GCC%" %CFLAGS% %LDFLAGS% "%BSP%\ae350\start.S" "%BSP%\ae350\ae350.c" "%BSP%\ae350\initfini.c" "%BSP%\ae350\interrupt.c" "%BSP%\ae350\reset.c" "%BSP%\ae350\trap.c" "%HERE%ready.c" -o "%OUT%\ready.adx" -lc -lgcc
+"%GCC%" %CFLAGS% %LDFLAGS% "%BSP%\ae350\start.S" "%BSP%\ae350\ae350.c" "%BSP%\ae350\cache.c" "%BSP%\ae350\initfini.c" "%BSP%\ae350\interrupt.c" "%BSP%\ae350\loader.c" "%BSP%\ae350\reset.c" "%BSP%\ae350\trap.c" "%HERE%ready.c" -o "%OUT%\ready.adx" -lc -lgcc
 if errorlevel 1 exit /b 1
 "%OBJCOPY%" -S -O binary "%OUT%\ready.adx" "%OUT%\ready.bin"
+"%OBJDUMP%" -h "%OUT%\ready.adx" | findstr /i ".bootloader" >nul
+if errorlevel 1 echo WARNING: no .bootloader section. Compare with falcon_m28.adx sections before flashing.
+"%OBJDUMP%" -h "%OUT%\ready.adx" | findstr /i ".text .data .bss .bootloader .loader"
 echo Flash output\ready.bin at 0x0600000. Leading 0. Not 0x6000000.
 endlocal
diff --git a/Atarist_030_wip/helper_fw/ready/ready.c b/Atarist_030_wip/helper_fw/ready/ready.c
index 0c10504..e6def2b 100644
--- a/Atarist_030_wip/helper_fw/ready/ready.c
+++ b/Atarist_030_wip/helper_fw/ready/ready.c
@@ -1,8 +1,29 @@
 /* AE350 serial proof. Not connected to the 030.
  * 115200 8N1 on UART2. "AE350 alive" means main started.
  * Flash at 0x0600000. Does not write the GPIO mark.
+ *
+ * UART2 is an Andes ATCUART100 (MUG1029 Table 7-1), not a bare 16550:
+ * the 16550 registers start at +0x20. Offsets 0x00-0x1C are IDREV/CFG/
+ * OSCR. The old stub polled +0x14 (OSCR, reset 0x10, bit 5 never set)
+ * as if it were LSR, so it spun before the first character.
+ *
+ * UCLK is assumed to be APB_CLK = 50 MHz (gowin_pll_ae350 clkout3).
+ * If the text arrives garbled, the baud is wrong, not the boot.
  */
-#define UART_BASE 0xF0300000u
+#define UART_BASE   0xF0300000u
+#define UART_OSCR   (UART_BASE + 0x14u)
+#define UART_THR    (UART_BASE + 0x20u)   /* DLL when DLAB=1 */
+#define UART_IER    (UART_BASE + 0x24u)   /* DLM when DLAB=1 */
+#define UART_FCR    (UART_BASE + 0x28u)
+#define UART_LCR    (UART_BASE + 0x2Cu)
+#define UART_MCR    (UART_BASE + 0x30u)
+#define UART_LSR    (UART_BASE + 0x34u)
+
+#ifndef UCLK_HZ
+#define UCLK_HZ     50000000u
+#endif
+#define BAUD        115200u
+#define OVERSAMPLE  16u
 
 static inline void wr(unsigned addr, unsigned val)
 {
@@ -15,18 +36,23 @@ static inline unsigned rd(unsigned addr)
 
 static void uart_init(void)
 {
-    wr(UART_BASE + 0x0Cu, 0x80u);          /* DLAB */
-    wr(UART_BASE + 0x00u, 27u);            /* 50 MHz / (16*115200) */
-    wr(UART_BASE + 0x04u, 0u);
-    wr(UART_BASE + 0x0Cu, 0x03u);          /* 8N1 */
-    wr(UART_BASE + 0x08u, 0x01u);          /* FIFO enable */
+    unsigned div = (UCLK_HZ + (OVERSAMPLE * BAUD) / 2u) / (OVERSAMPLE * BAUD); /* 27 */
+
+    wr(UART_OSCR, OVERSAMPLE);             /* reset value, set explicitly */
+    wr(UART_IER, 0u);                      /* no interrupts (DLAB=0) */
+    wr(UART_LCR, 0x80u);                   /* DLAB */
+    wr(UART_THR, div & 0xFFu);             /* DLL */
+    wr(UART_IER, (div >> 8) & 0xFFu);      /* DLM */
+    wr(UART_LCR, 0x03u);                   /* 8N1, DLAB off */
+    wr(UART_FCR, 0x07u);                   /* FIFO on, clear RX/TX */
+    wr(UART_MCR, 0u);
 }
 
 static void uart_putc(char c)
 {
-    while ((rd(UART_BASE + 0x14u) & 0x20u) == 0)
+    while ((rd(UART_LSR) & 0x20u) == 0)    /* THRE */
         ;
-    wr(UART_BASE + 0x00u, (unsigned)c);
+    wr(UART_THR, (unsigned)c);
 }
 
 static void uart_puts(const char *s)
